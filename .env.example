# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,web
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
BOOKING_MAX_RETRIES=3
AVAILABILITY_CACHE_TTL_SECONDS=5
IDEMPOTENCY_TTL_HOURS=24
DB_STATEMENT_TIMEOUT_MS=2000
WEB_CONCURRENCY=4
THROTTLE_BOOKING_RATE=60/min
THROTTLE_AVAILABILITY_RATE=120/min
LOG_LEVEL=INFO
LOG_FORMAT=json
